// Las funciones de /api las compila Vercel (@vercel/node), no el `tsc -b` del
// frontend: tsconfig.app.json sólo incluye "src". Sin este archivo, Vercel cae
// al tsconfig.json de la raíz, que no tiene compilerOptions, y entonces las
// funciones se chequean sin `strict` (se pierde el narrowing de uniones
// discriminadas) y con moduleResolution node16 (exige extensiones .js).
{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["**/*.ts"]
}
