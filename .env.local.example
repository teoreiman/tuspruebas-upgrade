# Variables de entorno para desarrollo local
# Copiá este archivo como .env.local y completá los valores

# ── Cloudinary (almacenamiento de archivos) ───────────────────────────────────
# 1. Creá cuenta gratis en https://cloudinary.com/users/register
# 2. En el Dashboard, copiá el "Cloud Name"
# 3. Andá a Settings → Upload → Upload presets → Add upload preset
#    - Poné cualquier nombre (ej: "tuspruebas")
#    - Signing Mode: Unsigned
#    - Save
VITE_CLOUDINARY_CLOUD_NAME=tu_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=tu_preset_name

# ── IA (backend) ──────────────────────────────────────────────────────────────
# La IA corre en el servidor (/api/ia): la clave NUNCA se expone al navegador,
# por eso NO lleva el prefijo VITE_.
# 1. Sacá una API key gratis en https://aistudio.google.com/apikey
# 2. Cargala como variable de entorno del proyecto (en Vercel: Settings →
#    Environment Variables) y también acá para desarrollo local.
GEMINI_API_KEY=
# Opcional: modelo a usar (por defecto gemini-2.5-flash, con fallback a
# gemini-2.0-flash si el primero no está disponible para tu key).
# GEMINI_MODEL=gemini-2.5-flash

# ── EmailJS (notificaciones de email al admin) ────────────────────────────────
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
